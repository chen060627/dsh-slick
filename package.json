{
  "name": "dsh-slick",
  "version": "1.1.0",
  "private": false,
  "description": "A kit of DeepSeek Harness conversation enhancements: paste-to-file conversion, in-place image annotation, Enter-to-steer, and a Codex-style reasoning-effort slider.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": {
    "name": "chen060627"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "annotation",
    "xlsx",
    "reasoning-effort",
    "slider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen060627/dsh-slick.git"
  },
  "bugs": {
    "url": "https://github.com/chen060627/dsh-slick/issues"
  },
  "homepage": "https://github.com/chen060627/dsh-slick#readme",
  "engines": {
    "dsh": "*"
  },
  "dependencies": {}
}
